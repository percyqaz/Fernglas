<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fernglas</ToolCommandName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="GitStatus.fs" />
    <Compile Include="CLI\AnsiCodes.fs" />
    <Compile Include="CLI\ScreenBuffer.fs" />
    <Compile Include="CLI\InputThread.fs" />
    <Compile Include="CLI\Keymap.fs" />
    <Compile Include="CLI\CommandBuffer.fs" />
    <Compile Include="CLI\TextBuffer.fs" />
    <Compile Include="State\Pane.fs" />
    <Compile Include="State\State.fs" />
    <Compile Include="State\ShellExtensions.fs" />
    <Compile Include="State\PaneCommands.fs" />
    <Compile Include="State\StateCommands.fs" />
    <Compile Include="UI\View.fs" />
    <Compile Include="Fernglas.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>